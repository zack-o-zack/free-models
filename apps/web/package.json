{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "catalogue:render": "bun ../../packages/json/src/cli.ts render --workspace ../../packages/json --output .generated/free-models.json",
    "dev": "bun run catalogue:render && next dev",
    "build": "bun run catalogue:render && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "logos:sync": "bun scripts/sync-brand-logos.ts",
    "seo:check": "bun scripts/audit-seo.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "json": "workspace:*",
    "lucide-react": "^1.37.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.0",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
