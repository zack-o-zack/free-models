# Set this to the public HTTPS origin before building a production deployment.
# Without it, local builds use localhost and disable indexing.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional override. On Cloudflare Workers Builds this is derived from
# WORKERS_CI_BRANCH: builds of "main" are indexable, any other branch is a
# preview. Set to "preview" to force noindex, nofollow and disallow crawling.
# SITE_ENVIRONMENT=preview
