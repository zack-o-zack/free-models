{
  "name": "free-models-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "catalogue": "bun run src/cli.ts",
    "catalogue:discover": "bun run src/cli.ts discover",
    "catalogue:reconcile": "bun run src/cli.ts reconcile",
    "catalogue:refresh": "bun run src/cli.ts refresh",
    "catalogue:render": "bun run src/cli.ts render",
    "catalogue:check": "bun run src/cli.ts check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "quality": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run aislop ci .",
    "check": "bun run quality && bun run catalogue:check"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/bun": "1.3.10",
    "aislop": "0.15.0",
    "typescript": "5.9.3"
  }
}
