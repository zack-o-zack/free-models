{
  "name": "free-models",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "catalogue": "bun run --filter json catalogue",
    "catalogue:discover": "bun run --filter json catalogue:discover",
    "catalogue:reconcile": "bun run --filter json catalogue:reconcile",
    "catalogue:refresh": "bun run --filter json catalogue:refresh",
    "catalogue:render": "bun run --filter json catalogue:render",
    "catalogue:check": "bun run --filter json catalogue:check",
    "catalogue:changelog": "bun run --filter json catalogue:changelog",
    "changelog": "bun run --filter json catalogue:changelog",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "bun run --filter json typecheck && bun run --filter web typecheck",
    "test": "bun test",
    "quality": "bun run format:check && bun run lint && bun run typecheck && bun test && bun scripts/quality-gate.ts .",
    "check": "bun run quality && bun run catalogue:render --output .scratch/free-models.json && bun run catalogue:check --input .scratch/free-models.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/bun": "1.3.10",
    "aislop": "0.18.1",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
